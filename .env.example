# Paari v4.0.0 — local sandbox template only.
# Copy to .env, then replace EVERY <...> placeholder. Never commit .env.
PAARI_ENV=sandbox
PAARI_MODE=standard
PAARI_HOME_JURISDICTION=IN
PAARI_DATABASE_URL=sqlite:///./paari.db
ALEMBIC_URL=sqlite:///./paari.db

# Core sandbox secrets. Generate independent high-entropy random values.
PAARI_ADMIN_API_KEY=<GENERATE_UNIQUE_SECRET>
PAARI_BENEFICIARY_HASH_SECRET=<GENERATE_UNIQUE_SECRET>
PAARI_V36_AUTH_SECRET=<GENERATE_UNIQUE_SECRET>
PAARI_V36_KEY_ENCRYPTION_SECRET=<GENERATE_UNIQUE_SECRET>
PAARI_V36_PII_HMAC_SECRET=<GENERATE_UNIQUE_SECRET>
PAARI_V37_DATA_ENCRYPTION_SECRET=<GENERATE_UNIQUE_SECRET>
PAARI_FINANCIAL_CONTEXT_ENCRYPTION_SECRET=<GENERATE_UNIQUE_32_PLUS_CHARACTER_SECRET>

# Signing backend: for a local sandbox, provision a fresh local key outside
# this source archive. For production, use a managed KMS/HSM adapter.
PAARI_SIGNING_BACKEND=local_pem
PAARI_SIGNING_KEY_PATH=./paari_signing_key.pem
PAARI_SIGNING_KEY_ID=paari-sandbox-1

# Governance. Keep strict financial-context freshness disabled until the
# complete Setu lifecycle has been configured and verified for the tenant.
PAARI_REQUIRE_SIGNED_MANDATE=1
PAARI_CONTROL_PLANE_ENFORCEMENT=0
PAARI_REQUIRE_REQUEST_PROOF=0
PAARI_REQUIRE_SAFR_ENVELOPE=0
PAARI_REQUIRE_FRESH_FINANCIAL_CONTEXT=0
PAARI_REQUIRE_TREASURY_BUDGET=0
PAARI_REQUIRE_RECEIVER_PRECHECK=0
PAARI_FINANCIAL_CONTEXT_MAX_AGE_HOURS=24

# Razorpay sandbox credentials. Do not use live credentials in this template.
RAZORPAY_API_BASE=https://api.razorpay.com/v1
RAZORPAY_KEY_ID=<RAZORPAY_TEST_KEY_ID>
RAZORPAY_KEY_SECRET=<RAZORPAY_TEST_KEY_SECRET>
RAZORPAY_WEBHOOK_SECRET=<GENERATE_RAZORPAY_TEST_WEBHOOK_SECRET>

# Setu Account Aggregator UAT. Use the URLs and IDs supplied for your Setu UAT
# application; keep disabled until user consent and mandate-binding flows work.
SETU_AA_ENABLED=false
SETU_AA_ENV=sandbox
SETU_AA_AUTH_BASE_URL=<SETU_UAT_AUTH_BASE_URL>
SETU_AA_BASE_URL=<SETU_UAT_AA_BASE_URL>
SETU_AA_CLIENT_ID=<SETU_CLIENT_ID>
SETU_AA_CLIENT_SECRET=<SETU_CLIENT_SECRET>
SETU_AA_PRODUCT_INSTANCE_ID=<SETU_PRODUCT_INSTANCE_ID>
SETU_AA_REQUIRE_SIGNED_MANDATE=1

# Mastercard/Finicity connector is separate from Setu and disabled by default.
MASTERCARD_ENABLED=false
MASTERCARD_ENV=sandbox
MASTERCARD_API_BASE_URL=https://api.finicity.com
MASTERCARD_PARTNER_ID=<MASTERCARD_PARTNER_ID>
MASTERCARD_PARTNER_SECRET=<MASTERCARD_PARTNER_SECRET>
MASTERCARD_APP_KEY=<MASTERCARD_APP_KEY>

# Optional demo / deployment settings. Do not enable production posture without
# the full operational, identity, provider, regulatory and security controls.
PAARI_KYB_SIMULATION=1
PAARI_REQUIRE_MTLS_INGRESS=0
PAARI_TRUSTED_IDENTITY_PROVIDER_IDS=
PAARI_IDENTITY_PROVIDER_ADAPTER=
PAARI_RECONCILE_INTERVAL=30
PAARI_RECONCILE_DEAD_LETTER_AFTER=5
