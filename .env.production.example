# Copy to .env.production locally. Populate from a secret manager; never commit.
PAARI_ENV=prod
PAARI_MODE=autonomous
PAARI_HOME_JURISDICTION=IN
DATABASE_URL=postgresql+psycopg://paari:REPLACE_WITH_SECRET@db:5432/paari
ALEMBIC_URL=postgresql+psycopg://paari:REPLACE_WITH_SECRET@db:5432/paari
POSTGRES_DB=paari
POSTGRES_USER=paari
POSTGRES_PASSWORD=REPLACE_WITH_HIGH_ENTROPY_SECRET

PAARI_ADMIN_API_KEY=REPLACE_WITH_32_PLUS_CHAR_RANDOM_SECRET
PAARI_BENEFICIARY_HASH_SECRET=REPLACE_WITH_32_PLUS_CHAR_RANDOM_SECRET
PAARI_V36_AUTH_SECRET=REPLACE_WITH_32_PLUS_CHAR_RANDOM_SECRET
PAARI_V36_KEY_ENCRYPTION_SECRET=REPLACE_WITH_32_PLUS_CHAR_RANDOM_SECRET
PAARI_V36_PII_HMAC_SECRET=REPLACE_WITH_32_PLUS_CHAR_RANDOM_SECRET
PAARI_V37_DATA_ENCRYPTION_SECRET=REPLACE_WITH_32_PLUS_CHAR_RANDOM_SECRET
PAARI_FINANCIAL_CONTEXT_ENCRYPTION_SECRET=REPLACE_WITH_32_PLUS_CHAR_RANDOM_SECRET

PAARI_CONTROL_PLANE_ENFORCEMENT=1
PAARI_RECEIVER_ENFORCEMENT=1
PAARI_FEDERATION_ENFORCEMENT=1
PAARI_REQUIRE_SIGNED_MANDATE=1
PAARI_REQUIRE_USER_MANDATE=1
PAARI_REQUIRE_SAFR_ENVELOPE=1
PAARI_REQUIRE_MTLS_INGRESS=1
PAARI_REQUIRE_TREASURY_BUDGET=1
PAARI_REQUIRE_RECEIVER_PRECHECK=1
PAARI_REQUIRE_FRESH_FINANCIAL_CONTEXT=1
PAARI_FINANCIAL_CONTEXT_MAX_AGE_HOURS=24
PAARI_RECONCILE_EMBEDDED_WORKER=0
PAARI_RECONCILE_INTERVAL=30
PAARI_RECONCILE_DEAD_LETTER_AFTER=8
PAARI_SIGNING_BACKEND=kms
PAARI_SIGNING_ADAPTER=YOUR_APPROVED_KMS_ADAPTER_MODULE
PAARI_SIGNING_KEY_ID=YOUR_MANAGED_SIGNING_KEY_ID
PAARI_IDENTITY_PROVIDER_ADAPTER=YOUR_TRUSTED_IDENTITY_PROVIDER_ADAPTER
PAARI_TRUSTED_IDENTITY_PROVIDER_IDS=YOUR_PINNED_PROVIDER_ID
PAARI_MTLS_CA_CERT=/run/secrets/paari_agent_ca.crt
PAARI_MTLS_TRUSTED_PROXY_CIDRS=YOUR_PRIVATE_INGRESS_CIDR
PAARI_KYB_SIMULATION=0

PAARI_DEFAULT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_live_REPLACE
RAZORPAY_KEY_SECRET=REPLACE
RAZORPAY_WEBHOOK_SECRET=REPLACE
RAZORPAY_API_BASE=https://api.razorpay.com/v1

SETU_AA_ENABLED=false
SETU_AA_ENV=production
SETU_AA_AUTH_BASE_URL=REPLACE_WITH_APPROVED_SETU_AUTH_URL
SETU_AA_BASE_URL=REPLACE_WITH_APPROVED_SETU_FIU_URL
SETU_AA_CLIENT_ID=REPLACE
SETU_AA_CLIENT_SECRET=REPLACE
SETU_AA_PRODUCT_INSTANCE_ID=REPLACE
